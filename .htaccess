RewriteEngine On

# 0. SEGURANÇA: nunca servir arquivos internos (planilhas de clientes, SQL,
#    documentação, scripts, mock de leads, configs do editor)
RewriteRule ^(dados-planilhas|sql|docs|scripts|\.claude)(/|$) - [R=404,L,NC]
RewriteRule ^leads_mock\.js$ - [R=404,L,NC]
RewriteRule \.code-workspace$ - [R=404,L,NC]

# 1. Redirecionar acessos diretos com .html para a URL limpa (ex: /proposta.html -> /proposta)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.html [NC]
RewriteRule ^ %1 [R=301,L]

# 2. Mapear internamente a URL limpa para o arquivo .html correspondente
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [NC,L]

# Cabeçalhos de segurança (só se o mod_headers estiver ativo no servidor)
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
